# Wake configuration. Copy to .env; Bun loads it from the working directory.
# Everything here has a working default — an empty .env is a valid .env, except
# that the Agent needs a key (below) and Gmail needs a token Wake can read.

# Set on the DevBox; without it the startup log claims [dev].
NODE_ENV=production

# --- where it listens ---------------------------------------------------------
WAKE_PORT=8585
WAKE_HOST=127.0.0.1
# Public origin. Used to build the OAuth redirect URL, push deep links, and the
# list of origins allowed to make a state-changing request — so it must match the
# address you actually open in a browser.
WAKE_PUBLIC_URL=https://yuvraj-wake.truto.dev
# WAKE_EXTRA_ORIGINS=            # comma-separated, only if you front it elsewhere

# --- who you are --------------------------------------------------------------
# Used to answer "is this addressed to me?" without a model, and to decide which
# mail is "to you" rather than merely unread.
WAKE_GITHUB_LOGIN=yuvraj3335
WAKE_EMAILS=yuvraj@redroot.one,engineering@redroot.one
# Discovered from Slack's own tool description when left blank.
# WAKE_SLACK_USER_ID=

# --- how often, how far back --------------------------------------------------
WAKE_POLL_INTERVAL_MS=180000
WAKE_REMINDER_TICK_MS=30000
WAKE_LOOKBACK_DAYS=14

# --- storage ------------------------------------------------------------------
# The database, plus voice recordings and launch packs, all live under here.
WAKE_DATA_DIR=/home/yuvraj/.local/share/wake
# WAKE_VOICE_DIR=<data>/voice
# WAKE_PACK_DIR=<data>/packs

# --- credentials --------------------------------------------------------------
# Normally unnecessary. Wake resolves tokens in this order:
#   1. its own OAuth store (Settings → Connect)
#   2. Claude Code's ~/.claude/.credentials.json  ← `claude mcp login slack`
#   3. the variables below
# A claude.ai *connector* is not step 2: those tokens live in your Claude
# account and are never written to disk, so Wake has nothing to read.
# WAKE_SLACK_TOKEN=
# WAKE_SENTRY_TOKEN=
# WAKE_GMAIL_TOKEN=
# GITHUB_TOKEN=   # otherwise taken from `gh auth token`

# Address push notifications are sent from (VAPID subject).
WAKE_VAPID_SUBJECT=mailto:yuvraj@redroot.one

# ---------------------------------------------------------------------------
# Open in Claude.
#
# Wake packs context and hands it over as a link — no key, no binary, no process.
# The brief travels in the query string, so it is capped; a longer one is trimmed
# and says so inside itself rather than stopping mid-sentence.
# ---------------------------------------------------------------------------
# WAKE_HANDOFF_URL=https://claude.ai/new
# WAKE_HANDOFF_PARAM=q
# WAKE_HANDOFF_MAX_CHARS=12000
# WAKE_CONFIRM_TTL_MS=600000               # how long a bound Send approval lasts

# ---------------------------------------------------------------------------
# The workspace a brief may name.
# ---------------------------------------------------------------------------
# WAKE_TRUTO_BIN=/home/yuvraj/.truto/bin/truto
# WAKE_WORKSPACE_ROOT=/home/yuvraj/work    # bounds which repos a brief can name

# Skill catalogs. Local checkouts win over any stale global copy.
# WAKE_SKILLS_TRUTO=/home/yuvraj/work/truto-skills
# WAKE_SKILLS_CURSOR=/home/yuvraj/work/Cursor-skills/.cursor/skills
# WAKE_SKILLS_REPO=/home/yuvraj/work/truto/.claude/skills

# --- voice --------------------------------------------------------------------
# Recording and live dictation are the browser's. Transcribing a *stored* note
# needs a service; unset, Wake keeps the audio and says transcription is
# unavailable rather than inventing a transcript.
# WAKE_STT_URL=https://api.openai.com/v1/audio/transcriptions
# WAKE_STT_MODEL=whisper-1
# WAKE_STT_KEY=
# WAKE_VOICE_MAX_BYTES=26214400
# WAKE_VOICE_MAX_SECONDS=600

# --- mail ---------------------------------------------------------------------
# WAKE_MAIL_CACHE_TTL_MS=300000            # how long a fetched thread stays usable
# WAKE_MAIL_PAGE_SIZE=25
